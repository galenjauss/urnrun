{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "e2e:setup": "wrangler d1 migrations apply urnrun-db --local && node e2e/seed.mjs > .wrangler/e2e-seed.sql && wrangler d1 execute urnrun-db --local --file .wrangler/e2e-seed.sql",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.2.8",
    "@fontsource/limelight": "^5.2.8",
    "@resvg/resvg-wasm": "2.6.2",
    "@urnrun/core": "workspace:*",
    "hono": "^4.10.6",
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@playwright/test": "1.49.1",
    "@react-router/dev": "^8.5.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.10",
    "wrangler": "^4.168.0"
  }
}
